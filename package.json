{
  "name": "tjklug.com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "new": "node scripts/new-post.mjs",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check . && markdownlint-cli2",
    "format": "prettier --write . && markdownlint-cli2 --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/lighthouse.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:links",
    "check:all": "npm run check && npm run test:e2e && npm run test:perf",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.3",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": "prettier --write",
    "src/content/**/*.{md,mdx}": "markdownlint-cli2 --fix"
  }
}
