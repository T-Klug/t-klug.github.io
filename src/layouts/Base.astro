---
import '@fontsource/archivo-narrow/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE, SOCIAL } from '../data/site';
import avatar from '../assets/img/avatar3.png';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  article?: { published: Date; tags: string[] };
  section?: 'posts' | 'about';
  /** For pages that should not be indexed or given a canonical URL, like the 404 page. */
  noindex?: boolean;
}

const { title, description = SITE.description, image = avatar, article, section, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
const analyticsId = import.meta.env.PROD ? SITE.analyticsId : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0a0e17" />
    <link rel="icon" href="/assets/img/favicons/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/img/favicons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/img/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/img/favicons/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tj_klug" />

    <!-- Apply a saved theme before first paint so light-mode readers never see a dark flash. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // Storage blocked: keep the dark default.
      }
    </script>
    {analyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            // gtag.js expects the arguments object itself, not an array.
            // eslint-disable-next-line prefer-rest-params
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="wrap">
      <header class="site-head">
        <a class="brand" href="/">
          tjklug.com
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#posts" aria-current={section === 'posts' ? 'page' : undefined}>
            Posts
          </a>
          <a href="/about/" aria-current={section === 'about' ? 'page' : undefined}>
            About
          </a>
          <a href="/feed.xml">RSS</a>
          <ThemeToggle />
        </nav>
      </header>
    </div>
    <main id="main">
      <slot />
    </main>
    <div class="wrap">
      <footer class="site-foot">
        <span>
          © {new Date().getFullYear()} {SITE.name} · Views are my own.
        </span>
        <nav aria-label="Elsewhere">
          {SOCIAL.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a href={`mailto:${SITE.email}`}>Email</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
