---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on tjklug.com." noindex>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">
        <b>404</b> / Not found
      </p>
      <h1 class="display">That page isn't here.</h1>
      <p>
        It may have moved when the site was rebuilt. <a href="/#posts">Browse all posts</a> or{' '}
        <a href="/tags/">find it by tag</a>.
      </p>
    </header>
  </div>
</Base>
