---
import Base from '../../layouts/Base.astro';
import PostTable from '../../components/PostTable';
import { getPosts, summarize, type PostSummary } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)).map(summarize) },
  }));
}

interface Props {
  posts: PostSummary[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag}`} description={`Posts tagged ${tag} on tjklug.com.`} section="posts">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">
        <a href="/tags/">
          <b>Tags</b>
        </a>{' '}
        / {tag}
      </p>
      <h1 class="display">#{tag}</h1>
    </header>
    <PostTable posts={posts} label="Tagged posts" />
  </div>
</Base>
