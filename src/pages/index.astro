---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Social from '../components/Social.astro';
import PostTable from '../components/PostTable';
import { SITE } from '../data/site';
import { dotDate, excerpt, isoDate, readingMinutes } from '../lib/format';
import { getPosts, postUrl, summarize } from '../lib/posts';
import { TOPICS } from '../lib/topics';

const FEATURED_COUNT = 3;

const posts = await getPosts();
// Newest first, so the featured row always holds the latest articles.
const featured = posts.slice(0, FEATURED_COUNT);
const summaries = await Promise.all(posts.map(summarize));
---

<Base>
  <div class="wrap">
    <section class="hero" aria-labelledby="intro">
      <div>
        <p class="eyebrow">
          <b>{SITE.name}</b> / {SITE.role}
        </p>
        <h1 id="intro" class="display">
          {SITE.headline}
        </h1>
        <p class="lede">{SITE.lede}</p>
        <p class="bio">{SITE.bio}</p>
        <Social />
      </div>
      <Portrait caption={['tj_klug', `${posts.length} posts`]} priority />
    </section>

    <section aria-labelledby="featured">
      <div class="label-bar">
        <h2 id="featured">Featured articles</h2>
        <span>{String(featured.length).padStart(2, '0')}</span>
      </div>
      <div class="cells">
        {featured.map((post) => (
          <a class="cell" href={postUrl(post.id)}>
            <Image
              class="cover"
              src={post.data.image}
              alt=""
              width={680}
              widths={[360, 680]}
              sizes="(max-width: 760px) 100vw, 340px"
              format="webp"
            />
            <div class="lab">
              <time datetime={isoDate(post.data.date)}>{dotDate(post.data.date)}</time> · {TOPICS[post.data.topic]}
            </div>
            <h3 class="display">{post.data.title}</h3>
            <p class="sum">{post.data.description ?? excerpt(post.body ?? '')}</p>
            <div class="go">Read · {readingMinutes(post.body ?? '')} min →</div>
          </a>
        ))}
      </div>
    </section>

    <section id="posts" aria-label="All posts">
      <PostTable client:visible={{ rootMargin: '600px' }} posts={summaries} filterable />
    </section>
  </div>
</Base>
